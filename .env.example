# Firefly III base URL (no trailing slash, no /api)
FIREFLY_BASE_URL=http://10.10.254.13:8090
# Personal access token from Firefly -> Options -> Profile -> OAuth -> Personal Access Tokens
FIREFLY_TOKEN=
# The account the forecast projects (Lloyds Current Account)
FIREFLY_CURRENT_ACCOUNT_ID=1
# Payday weekday: 0=Sunday .. 4=Friday
FIREFLY_PAYDAY_WEEKDAY=4
# Cash to keep untouched
FIREFLY_BUFFER=0
# Optional annual-leave spans, pay is lower in those weeks
# FIREFLY_HOLIDAYS_JSON={"spans":[{"start":"2026-11-09","end":"2026-11-13"}]}
